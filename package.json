{
  "name": "libre-note-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs && node scripts/bundle-plugin.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "format:check": "prettier . --check",
    "knip": "knip --include files,dependencies,unlisted,unresolved,duplicates",
    "lint": "eslint .",
    "obsidian:dev": "start \"\" \"obsidian://open?vault=Obsidian%20Vault\"",
    "release": "npm test && npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run build",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "description": "Standalone rich-note editor workspace for Obsidian with a React-based custom view.",
  "dependencies": {
    "@fluentui/react-icons": "^2.0.328",
    "@lexical/html": "^0.45.0",
    "@lexical/react": "^0.45.0",
    "classnames": "^2.5.1",
    "gray-matter": "^4.0.3",
    "lexical": "^0.45.0",
    "obsidian": "latest",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@eslint/js": "^9.29.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^5.88.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.58.2"
  }
}
