exports[`matches md_2 complex nested markdown conversion snapshot 1`] = `
{
  "frontmatter": "title: 'Complex Nested Markdown Reference'
aliases:
  - 'Stress Fixture'
  - 'Nested Tags And Embeds'
date: 2026-05-31
tags:
  - fixture/markdown/stress
  - fixture/embed/deep
  - status/in-progress
cssclasses:
  - libre-note-fixture
  - markdown-torture-test
metadata:
  owner:
    name: Dragus
    tags:
      - person/test-owner
      - person/editor-reviewer
  nested:
    level_one:
      level_two:
        level_three: 'frontmatter nesting should stay preserved'",
  "html": <div>
    <article
      data-libre-note-editor-html=""
    >
      <template
        data-libre-protected="frontmatter"
      />
      <h1>
        Complex Nested Markdown Reference
      </h1>
      

      <p>
        This fixture intentionally mixes valid markdown, Obsidian syntax, raw HTML, malformed
markdown, nested tags, embeds, callouts, tables, footnotes, block IDs, and code fences.
It is modeled after 
        <code>
          tag-regex-reference.md
        </code>
        , but pushes more nested combinations.
      </p>
      

      <h2>
        Inline Formatting And Tags
      </h2>
      

      <p>
        Paragraph with 
        <strong>
          bold and 
          <em>
            italic and ==highlight with 
            <code>
              inline code
            </code>
             inside==
          </em>
        </strong>
         plus

        <del>
          strike with 
          <span
            data-libre-markdown="#status/in-progress"
            data-libre-protected="obsidian-tag"
            data-obsidian-tag="status/in-progress"
          >
            #status/in-progress
          </span>
           nested beside 
          <span
            data-libre-markdown="[[Project Hub#Deep Heading|hub link]]"
            data-libre-protected="obsidian-wiki-link"
            data-obsidian-target="Project Hub#Deep Heading"
          >
            hub link
          </span>
        </del>
        .
      </p>
      

      <p>
        Tags in sequence: 
        <span
          data-libre-markdown="#alpha"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="alpha"
        >
          #alpha
        </span>
         
        <span
          data-libre-markdown="#alpha/beta"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="alpha/beta"
        >
          #alpha/beta
        </span>
         
        <span
          data-libre-markdown="#alpha/beta/gamma"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="alpha/beta/gamma"
        >
          #alpha/beta/gamma
        </span>
         
        <span
          data-libre-markdown="#alpha-beta/gamma_delta"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="alpha-beta/gamma_delta"
        >
          #alpha-beta/gamma_delta
        </span>
        

        <span
          data-libre-markdown="#emoji-ish/smile-test"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="emoji-ish/smile-test"
        >
          #emoji-ish/smile-test
        </span>
         
        <span
          data-libre-markdown="#todo"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="todo"
        >
          #todo
        </span>
         
        <span
          data-libre-markdown="#todo/deep/item"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="todo/deep/item"
        >
          #todo/deep/item
        </span>
         
        <span
          data-libre-markdown="#todos-should-not-collapse"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="todos-should-not-collapse"
        >
          #todos-should-not-collapse
        </span>
        .
      </p>
      

      <p>
        Escaped and adjacent tags: text#not-a-tag, 
        <code>
          #code/not-tag
        </code>
        , #escaped/tag,
(
        <span
          data-libre-markdown="#wrapped/tag"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="wrapped/tag"
        >
          #wrapped/tag
        </span>
        ), 
        <a
          href="https://example.com/tagged"
        >
          <span
            data-libre-markdown="#linked/tag"
            data-libre-protected="obsidian-tag"
            data-obsidian-tag="linked/tag"
          >
            #linked/tag
          </span>
        </a>
        , and 
        <span
          data-libre-markdown="#final/tag"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="final/tag"
        >
          #final/tag
        </span>
        .
      </p>
      

      <h2>
        Headings With Raw Html And Strange Markers
      </h2>
      

      <h1>
        <b>
          HTML-looking Heading
        </b>
      </h1>
      

      <h2>
        <span
          style="color:red"
        >
          Styled Heading Text
        </span>
      </h2>
      

      <h3>
        Heading With 
        <span
          data-libre-markdown="[[Nested Link#Inside Heading|linked alias]]"
          data-libre-protected="obsidian-wiki-link"
          data-obsidian-target="Nested Link#Inside Heading"
        >
          linked alias
        </span>
      </h3>
      

      <h4>
        Heading With 
        <span
          data-libre-markdown="#heading/tag"
          data-libre-protected="obsidian-tag"
          data-obsidian-tag="heading/tag"
        >
          #heading/tag
        </span>
         and 
        <span
          data-libre-markdown="![[Heading Embed.png]]"
          data-libre-protected="obsidian-embed"
          data-obsidian-target="Heading Embed.png"
        >
          ![[Heading Embed.png]]
        </span>
      </h4>
      

      <h5>
        Heading With 
        <code>
          inline code
        </code>
         and ==highlight==
      </h5>
      

      <h6>
        Deep Legal Heading
      </h6>
      

      <p>
        ####### Seven Hashes Should Stay Paragraph Text
      </p>
      

      <h2>
        Lists, Tasks, And Nested Tags
      </h2>
      

      <ul
        class="contains-task-list"
      >
        

        <li>
          Top item 
          <span
            data-libre-markdown="#list/top"
            data-libre-protected="obsidian-tag"
            data-obsidian-tag="list/top"
          >
            #list/top
          </span>
          

          <ul>
            

            <li>
              Nested item with 
              <span
                data-libre-markdown="[[Nested/Path/Note#Anchor|alias]]"
                data-libre-protected="obsidian-wiki-link"
                data-obsidian-target="Nested/Path/Note#Anchor"
              >
                alias
              </span>
               
              <span
                data-libre-markdown="#list/top/child"
                data-libre-protected="obsidian-tag"
                data-obsidian-tag="list/top/child"
              >
                #list/top/child
              </span>
              

              <ul>
                

                <li>
                  Deep item with 
                  <span
                    data-libre-markdown="![[Nested Image.png|320x180]]"
                    data-libre-protected="obsidian-embed"
                    data-obsidian-target="Nested Image.png"
                  >
                    ![[Nested Image.png|320x180]]
                  </span>
                   
                  <span
                    data-libre-markdown="#list/top/child/embed"
                    data-libre-protected="obsidian-tag"
                    data-obsidian-tag="list/top/child/embed"
                  >
                    #list/top/child/embed
                  </span>
                  

